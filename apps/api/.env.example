PORT=8080
NODE_ENV=development
DATA_DIR=./data
# Deepgram STT is OFF by default. Native Google Meet captions need no Deepgram key.
# Leave disabled; opt-in only if intentionally reintroducing remote STT later.
ZAPPER_ENABLE_DEEPGRAM_STT=false
DEEPGRAM_API_KEY=
JWT_SECRET=replace-with-long-random-secret
ADMIN_KEY=replace-with-another-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-8-plus-character-password
ADMIN_NAME=Zapper Admin
WEB_ORIGINS=http://localhost:5173,https://zapper-prod.vercel.app,https://zapperapp.in,https://www.zapperapp.in
PLAN_PRICE_INR=999
PORTAL_TOKEN_DAYS=7
HOST_SESSION_HOURS=12
# Hard maximum host session duration. Zapper caps this at 210 minutes (3h 30m).
HOST_SESSION_MAX_MINUTES=210
PARTICIPANT_TOKEN_MINUTES=210
SESSION_RETENTION=15
TRANSCRIPT_RETENTION=15

# Legacy idle setting retained for compatibility. Silence does not end a session.
# Sessions end when the host clicks End Session or when the 210-minute hard maximum is reached.
SESSION_IDLE_TIMEOUT_MINUTES=20
# PDF-only pause marker threshold. Live overlay is unchanged.
PDF_PAUSE_TIMESTAMP_SECONDS=30

# Password reset
PASSWORD_RESET_MINUTES=30
# Use your current web origin while testing; switch to https://zapperapp.in after custom-domain launch.
PASSWORD_RESET_BASE_URL=https://zapper-prod.vercel.app
# Recommended production email provider for Forgot Password links.
RESEND_API_KEY=
# Demo request emails are sent to zapperapp.supported@gmail.com.
# You may reuse the verified sender already used for password-reset emails.
DEMO_FROM_EMAIL=Zapper <no-reply@zapperapp.in>
PASSWORD_RESET_FROM=Zapper <no-reply@zapperapp.in>
# Testing only: when true, forgot-password API also returns the generated reset URL. Keep false in production.
PASSWORD_RESET_RETURN_LINK=false

# Optional: automatic Google Meet creation on the Host Dashboard.
# In Google Cloud Console, enable Google Meet REST API and configure an OAuth
# 2.0 Web application client. Add the redirect URI below EXACTLY to the client.
# Add the client ID/secret to Railway (not Vercel); never commit real secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.zapperapp.in/api/google/meet/callback

# Cashfree hosted one-time payment orders. Obtain live/sandbox credentials from
# your own Cashfree Merchant Dashboard. Never commit production credentials.
# Cashfree and your merchant account must be approved before live payments work.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
WEB_APP_URL=https://www.zapperapp.in
PUBLIC_API_URL=https://api.zapperapp.in
# Cashfree webhook URL: https://api.zapperapp.in/api/payments/cashfree/webhook
